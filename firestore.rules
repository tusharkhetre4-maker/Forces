rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Events: Publicly readable for students, writeable for admin/coordinators
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Registrations: Students can register for events and view passes
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // Complaints: Anonymous grievance submissions for transparent oversight
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Ratings: Anonymous peer reviews and ratings for committee members
    match /ratings/{ratingId} {
      allow read, write: if true;
    }

    // Safety fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
